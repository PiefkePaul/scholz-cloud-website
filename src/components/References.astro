const entries: LogoEntry[] = [
  { id: 'microsoft', name: 'Microsoft', href: 'https://www.microsoft.com/de-de', type: 'img', mono: '/images/logos/microsoft-mono.png', color: '/images/logos/microsoft-color.png', width: 300, height: 93 },
  { id: 'synaxon', name: 'SYNAXON AG', href: 'https://synaxon.com/de-de/', type: 'html', mono: toMonoSvg(synaxonSvg), color: synaxonSvg, scale: 0.52 },
  { id: 'securepoint', name: 'Securepoint', href: 'https://www.securepoint.de', type: 'img', mono: '/images/logos/securepoint-mono.png', color: '/images/logos/securepoint-color.png', width: 315, height: 206 },
  { id: 'google', name: 'Google', href: 'https://www.google.com', type: 'img', mono: '/images/logos/google-mono.png', color: '/images/logos/google-color.png', width: 626, height: 640 },
  {
    id: 'dahlmann',
    name: isEnglish ? 'Autohaus Dahlmann (VW dealership)' : 'Autohaus Dahlmann (VW-Vertragshändler)',
    href: 'https://www.autohaus-dahlmann.de',
    type: 'img',
    mono: '/images/logos/autohaus-dahlmann-mono.png',
    color: '/images/logos/autohaus-dahlmann-color.png',
    width: 496,
    height: 132,
    scale: 1.12,
    badge: { mono: vwMono, color: vwColor, scale: 0.6 },
  },
  { id: 'drv-bund', name: isEnglish ? 'German Federal Pension Fund' : 'Deutsche Rentenversicherung Bund', href: 'https://www.deutsche-rentenversicherung-bund.de', type: 'html', mono: toMonoSvg(drvBundSvg), color: drvBundSvg },
  { id: 'dfwr', name: isEnglish ? 'German Forestry Council (DFWR)' : 'Deutscher Forstwirtschaftsrat (DFWR)', href: 'https://www.dfwr.de', type: 'img', mono: '/images/logos/dfwr-text-mono.png', color: '/images/logos/dfwr-text-color.png', width: 585, height: 169 },
  { id: 'baecker-feihl', name: 'Der Bäcker Feihl', href: 'https://baecker-feihl.de', type: 'img', mono: '/images/logos/baecker-feihl-mono.png', color: '/images/logos/baecker-feihl-color.png', width: 400, height: 128 },
  { id: 'arvato', name: 'Arvato Systems', href: 'https://www.arvato-systems.de', type: 'img', mono: '/images/logos/arvato-mono.png', color: '/images/logos/arvato-color.png', width: 640, height: 275 },
  { id: 'apple', name: 'Apple', href: 'https://www.apple.com/de/', type: 'html', mono: appleMono, color: appleMono },
  { id: 'terra', name: 'TERRA (Wortmann AG)', href: 'https://www.wortmann.de', type: 'img', mono: '/images/logos/terra-mono.png', color: '/images/logos/terra-color.png', width: 213, height: 90, scale: 1.2 },
];

const sectionLabel = isEnglish
  ? 'Enterprise environments I have contributed to'
  : 'Enterprise-Umgebungen, an denen ich mitgewirkt habe';
---

<section class="border-y border-white/[0.06] bg-[#0c1322] py-6" aria-label={sectionLabel}>
  <h2 class="sr-only">{sectionLabel}</h2>

  <div class="mx-auto max-w-6xl px-6 lg:px-10 xl:px-12">
    <div
      class="marquee-wrap relative overflow-x-hidden overflow-y-visible"
      style="mask-image: linear-gradient(to right, transparent, black 32px, black calc(100% - 32px), transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 32px, black calc(100% - 32px), transparent);"
      data-logo-marquee
    >
      <div class="marquee-track mx-auto flex w-max items-center gap-10 px-8" data-logo-track>
        {entries.map((entry) => (
          <LogoMark entry={entry} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-wrap {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .marquee-wrap::-webkit-scrollbar {
    display: none;
  }

  .marquee-wrap.is-marquee .marquee-track {
    animation: marquee 34s linear infinite;
  }

  .marquee-wrap.is-marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  /* Deliberate exception to the sitewide reduced-motion rule below — this strip must keep scrolling. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-wrap.is-marquee .marquee-track {
      animation-duration: 34s !important;
      animation-iteration-count: infinite !important;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  import { initLogoMarquee } from '../scripts/logo-marquee';
  initLogoMarquee();
</script>
